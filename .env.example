# Required application login credentials. Set these in the hosting provider's
# encrypted environment-variable settings for production.
DATABASE_URL=
APP_LOGIN_EMAIL=
APP_LOGIN_PASSWORD=
APP_SESSION_SECRET=

# Gmail SMTP credentials for invoice, receipt, and payment-reminder email.
# Use a Google App Password, not your normal Google account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opening balances used by the financial statement reports (NGN).
FINANCIAL_OPENING_BANK_BALANCE=100301.33
FINANCIAL_SHARE_CAPITAL=100301.33
